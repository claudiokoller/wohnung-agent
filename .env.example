# Kopieren als .env (NICHT ins Git committen!)
# Wird von systemd-Services via EnvironmentFile geladen.

WOHNUNGS_BOT_TOKEN=123456:ABC...

WOHNUNGS_IMAP_HOST=imap.gmail.com
WOHNUNGS_IMAP_PORT=993
WOHNUNGS_IMAP_USER=wohnung.suchen@example.com
WOHNUNGS_IMAP_PASS=xxxxxxxxxxxxxxxx
WOHNUNGS_IMAP_FOLDER=wohnung

WOHNUNGS_DB=/home/USER/wohnungs-bot/listings.db

# Optional: Draft-Ablage in privatem Postfach des Bewerbers
# (nur ausfüllen wenn DRAFT_IMAP_APPEND = True in config.py)
WOHNUNGS_DRAFT_FOLDER=[Gmail]/Drafts
